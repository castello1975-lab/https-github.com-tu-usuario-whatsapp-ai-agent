# Supabase — supabase.com dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com > API Keys (necesita crédito cargado)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Calendar — console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# WhatsApp Cloud API — ya NO se configura aquí. Cada organización pega sus
# credenciales (Phone Number ID, Access Token, WABA ID, App Secret, Verify
# Token) desde el panel: Integraciones > WhatsApp Business. Ver SETUP.md paso 8.

# Seguridad — generar con: node scripts/gen-encryption-key.mjs
ENCRYPTION_KEY=

# App — cambiar por la URL https de ngrok mientras se prueba el webhook
NEXT_PUBLIC_APP_URL=http://localhost:3000
